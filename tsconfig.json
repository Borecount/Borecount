{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": ".",
    "baseUrl": ".",
    "paths": {
      "@borecount/core": [
        "packages/core/src/index.ts"
      ],
      "@borecount/core/*": [
        "packages/core/src/*"
      ],
      "@borecount/http": [
        "packages/http/src/index.ts"
      ],
      "@borecount/http/*": [
        "packages/http/src/*"
      ],
      "@borecount/postgres-adapter": [
        "packages/postgres-adapter/src/index.ts"
      ],
      "@borecount/postgres-adapter/*": [
        "packages/postgres-adapter/src/*"
      ],
      "@borecount/express-routes": [
        "packages/express-routes/src/index.ts"
      ],
      "@borecount/express-routes/*": [
        "packages/express-routes/src/*"
      ],
      "@borecount/fastify-routes": [
        "packages/fastify-routes/src/index.ts"
      ],
      "@borecount/fastify-routes/*": [
        "packages/fastify-routes/src/*"
      ]
    },
    "types": [
      "bun-types"
    ]
  },
  "include": [
    "packages/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
